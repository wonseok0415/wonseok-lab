{
  "endpoint_url": "https://script.google.com/macros/s/AKfycbxqmzxbm99Fi9vrKgLxCslUwwEl8TxiyUN6LPMwimf04yjQjIO1s2tjC2jWKnR7iCSrSQ/exec",
  "api_key": "여기에_새_FC_API_KEY_입력",
  "samplerate": 16000,
  "voice_threshold_dbfs": -45,
  "voice_over_floor_db": 8,
  "dba_calibration_offset": 0,
  "speech_window_seconds": 1.0,
  "speech_voiced_ratio": 0.7,
  "wake_gap_seconds": 1.5,
  "post_silence_seconds": 2.0,
  "max_response_wait_seconds": 60,
  "post_timeout_seconds": 45,
  "consecutive_fails_for_alert": 1,
  "loop_interval_minutes": 30,
  "active_hours": "07:00-19:00",
  "output_device": null,
  "input_device": null,
  "booking_avoidance": {
    "enabled": true,
    "guard_before_minutes": 20,
    "guard_after_minutes": 10,
    "avoid_blocked": true,
    "avoid_pending": false,
    "on_query_failure": "skip",
    "slot_windows": {
      "1": "09:00-10:30",
      "2": "13:00-14:30",
      "3": "15:00-16:30"
    }
  },
  "stt": {
    "enabled": true,
    "engine": "auto",
    "model": "small",
    "language": "ko",
    "min_chars": 4,
    "vocabulary_hint": "ThinQ ON, 하이 엘지, 사용자님, 마곡, 등촌동, 강서구, 기온, 습도, 강수확률, 미세먼지, 흐림, 소나기, 천둥, 에어컨, 공기청정기, 세탁기, 건조기, 스타일러, 정수기, 조명, 커튼, 웰컴모드, 외출 모드, 루틴, 다운라이트",
    "forbid_any_default": [
      "모르겠",
      "죄송",
      "다시 말씀",
      "이해하지 못",
      "이해할 수 없",
      "지원하지 않",
      "확인할 수 없",
      "알 수 없",
      "찾지 못했",
      "찾을 수 없"
    ]
  },
  "scenarios": [
    {
      "id": "l1_ask_time",
      "label": "기동어 응답 — 시간 질문",
      "level": "L1",
      "wake_file": "phrases/wake.wav",
      "phrase_file": "phrases/ask_time.wav",
      "listen_seconds": 15,
      "expect_any": [
        "시",
        "오전",
        "오후",
        "정각"
      ]
    },
    {
      "id": "l1_smalltalk",
      "label": "일상 대화(순수) — 자유 질문",
      "level": "L1",
      "wake_file": "phrases/wake.wav",
      "phrase_file": "phrases/smalltalk.wav",
      "listen_seconds": 25
    },
    {
      "id": "l1_weather",
      "label": "일상 대화(서비스 연계) — 날씨 질문",
      "level": "L1",
      "wake_file": "phrases/wake.wav",
      "phrase_file": "phrases/ask_weather.wav",
      "listen_seconds": 20,
      "expect_any": [
        "날씨",
        "기온",
        "맑",
        "흐",
        "비",
        "눈",
        "구름",
        "더위",
        "추위"
      ]
    },
    {
      "id": "l3_combo_on",
      "label": "가전 제어 — 복합 명령 (다운라이트 켜기 + 커튼 열기)",
      "level": "L3",
      "wake_file": "phrases/wake.wav",
      "phrase_file": "phrases/combo_on.wav",
      "confirm_file": "phrases/confirm_yes.wav",
      "listen_seconds": 6,
      "expect_any": [
        "다운라이트",
        "커튼",
        "조명"
      ],
      "camera": {
        "device": 0,
        "interval_seconds": 1.0,
        "min_delta": 0.15,
        "sustain": 3,
        "watch_seconds": 50,
        "expect": "on"
      }
    },
    {
      "id": "l3_away_routine",
      "label": "가전 제어 — 외출 모드 (일괄 복구 + 루틴 판정)",
      "level": "L3",
      "wake_file": "phrases/wake.wav",
      "phrase_file": "phrases/routine_away.wav",
      "confirm_file": "phrases/confirm_yes.wav",
      "listen_seconds": 6,
      "expect_any": [
        "외출"
      ],
      "camera": {
        "device": 0,
        "interval_seconds": 1.0,
        "min_delta": 0.15,
        "sustain": 3,
        "watch_seconds": 50,
        "expect": "off"
      }
    }
  ]
}
